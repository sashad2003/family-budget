#!/bin/sh
#
# Поднимает номер версии кеша, если в коммит попал код, стили или разметка.
#
# Без этого выпуск с забытым номером застревает у людей в браузере на месяц:
# файлы отдаются как immutable, и старый адрес больше не перепроверяется.
# Полагаться тут на память нельзя — уже забывали.
#
# Хук включается один раз командой:
#   git config core.hooksPath .githooks

set -e

# Что уходит в коммит. Пусто — значит менялось что-то другое, номер ни при чём.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
code=$(printf '%s\n' "$staged" | grep -E '\.(js|mjs|css|html|webmanifest)$' | grep -v '^tools/' || true)

[ -z "$code" ] && exit 0

# Номер могли поднять и вручную — тогда второй раз не трогаем.
old=$(git show HEAD:index.html 2>/dev/null | sed -n 's/.*app\.css?v=\([0-9]*\).*/\1/p' | head -1)
new=$(sed -n 's/.*app\.css?v=\([0-9]*\).*/\1/p' index.html | head -1)

if [ -n "$old" ] && [ "$old" != "$new" ]; then
  echo "Версия кеша уже поднята вручную: $old → $new"
  exit 0
fi

node tools/bump-version.mjs

# Номер обязан быть единым во всём проекте: модули импортируют друг друга с тем
# же ?v, и разъехавшиеся версии тянут свежий файл вместе со старым. Поэтому в
# коммит идут все затронутые файлы, а не только те, что были в нём изначально.
git add -u
