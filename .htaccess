# Код и разметка отдаются с разной выдержкой, и это важно для скорости.
#
# Раньше все js и css перепроверялись при каждом заходе. Файлов у нас три
# десятка, и на каждый уходил отдельный запрос к серверу — только на эти
# проверки уходили секунды, хотя менялось раз в неделю ничего.
#
# Теперь код кешируется надолго: в каждом импорте стоит ?v=НОМЕР, который
# поднимается при выпуске правок, и адрес файла меняется вместе с ним. Браузер
# видит новый адрес и берёт свежий файл, а старые адреса ему больше не нужны.
#
# Слова immutable здесь намеренно нет, хотя напрашивается.
#
# Оно означает «по этому адресу содержимое не изменится никогда» и запрещает
# браузеру перепроверять файл даже тогда, когда человек сам обновляет страницу.
# Пока номер версии поднимается при каждом выпуске, это честно. Но стоит один
# раз забыть — и приложение застревает старым на месяц у всех, кто заходил:
# обновление страницы не помогает, помогает только чистка кеша, которую обычный
# человек делать не станет и не обязан. Так уже случалось.
#
# Без immutable обычные заходы всё так же берут файлы из кеша молча, а вот
# осознанное обновление страницы заставляет браузер спросить сервер и получить
# короткое «не менялось». Цена — десяток дешёвых запросов на тех, кто и так
# заподозрил неладное. Взамен поломка чинится тем единственным действием,
# которое человек делает сам.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=2592000"
    Header unset Pragma
  </FilesMatch>

  # Разметка и манифест адреса не меняют — их перепроверяем всегда,
  # иначе новый номер версии до браузера просто не доедет.
  <FilesMatch "\.(html|json|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
    Header unset Pragma
  </FilesMatch>

  # Service worker решает, что показывать без сети. Закешированный намертво,
  # он удержал бы старую версию приложения — его проверяем каждый раз.
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
  </FilesMatch>
</IfModule>

# Манифест обязан отдаваться этим типом, иначе телефон не предложит установку.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html            "access plus 0 seconds"
  ExpiresByType text/css             "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript      "access plus 30 days"
  # Картинки и шрифты меняются редко.
  ExpiresByType image/png            "access plus 30 days"
  ExpiresByType image/jpeg           "access plus 30 days"
  ExpiresByType image/svg+xml        "access plus 30 days"
  ExpiresByType font/woff2           "access plus 30 days"
</IfModule>
