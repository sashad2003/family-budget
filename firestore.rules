rules_version = '2';

// Схема:
//   users/{uid}                профиль: имя, почта, телефон, подписка, familyId
//   inviteCodes/{code}         ссылка-приглашение в конкретный бюджет
//   families/{familyId}
//     ├─ transactions/{txId}
//     ├─ categories/{catId}
//     ├─ bills/{billId}        (регулярные платежи)
//     └─ meta/{docId}          (rates, settings)
//   prices/{priceId}           общая база цен, читают все
//
// Доступ к бюджету: только участники семьи (uid в memberUids).
// Присоединиться можно, только предъявив код из ссылки-приглашения.

service cloud.firestore {
  match /databases/{database}/documents {

    function familyDoc(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data;
    }

    function isMember(familyId) {
      return request.auth != null
        && request.auth.uid in familyDoc(familyId).memberUids;
    }

    // Хозяин бюджета — тот, кто его завёл. Только он меняет состав участников.
    function isOwner(familyId) {
      return request.auth != null
        && familyDoc(familyId).ownerUid == request.auth.uid;
    }

    /**
     * Из состава никто не пропал, кроме, может быть, самого пишущего.
     *
     * Выйти из бюджета вправе каждый — это отказ от доступа. А вот выкинуть
     * другого может только хозяин, иначе приглашённый выставил бы из бюджета
     * того, кто его туда позвал.
     */
    function keepsEveryoneElse(familyId) {
      return request.resource.data.memberUids.hasAll(
        resource.data.memberUids.removeAll([request.auth.uid])
      );
    }

    function myEmail() {
      return request.auth != null ? request.auth.token.email : '';
    }

    // Меня пустят к чужим профилям — это админ-панель. Список закрытый и
    // лежит в правилах, а не в коде страницы: спрятать кнопку недостаточно.
    function isAdmin() {
      return request.auth != null
        && myEmail() in ['sashad2003@gmail.com'];
    }

    /**
     * Человек предъявил код приглашения в самом запросе.
     *
     * Знание кода и есть пропуск: код лежит только в ссылке, которую хозяин
     * бюджета послал лично. Проверять сохранённое в семье значение бессмысленно —
     * при обновлении оно попадает в запрос само, ничего не доказывая.
     */
    function joinsWithCode(familyId) {
      return request.auth != null
        && request.resource.data.joinCode is string
        && exists(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinCode))
        && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinCode))
             .data.familyId == familyId;
    }

    // ---------------------------------------------------------------- профили

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());

      // Профиль заводит себе сам человек. Почту подменить нельзя — она из токена.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.email == myEmail();

      // Менять можно имя, телефон и согласие на письма. Состояние подписки
      // ставит сервер после оплаты, руками её себе не включить.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.subscription == resource.data.subscription
        && request.resource.data.trialEndsAt == resource.data.trialEndsAt;

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------- приглашения

    match /inviteCodes/{code} {
      // Читает любой вошедший: код известен только тому, кому дали ссылку,
      // а по нему нужно узнать, в какой бюджет он ведёт.
      allow read: if request.auth != null;

      // Заводит и отзывает ссылку только участник этого бюджета.
      allow create: if isMember(request.resource.data.familyId);
      allow delete: if isMember(resource.data.familyId);
      allow update: if false;
    }

    // ---------------------------------------------------------------- семьи

    match /families/{familyId} {
      allow read: if isMember(familyId);

      // Свою семью человек создаёт при регистрации: он в ней и владелец,
      // и единственный участник. Записать себе чужих в момент создания нельзя.
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];

      // Настройки бюджета правит любой участник, состав — только хозяин.
      // Пришедший по ссылке может добавить в состав только себя.
      allow update: if (isMember(familyId) && (isOwner(familyId) || keepsEveryoneElse(familyId)))
        || (
          joinsWithCode(familyId)
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.hasOnly(
               resource.data.memberUids.concat([request.auth.uid])
             )
        );

      // Удаление семьи — только вручную через консоль: за ней тянутся все записи.
      allow delete: if false;

      match /transactions/{txId} {
        allow read: if isMember(familyId);
        allow create: if isMember(familyId)
          && request.resource.data.createdBy.uid == request.auth.uid;
        allow update, delete: if isMember(familyId);
      }

      match /categories/{catId} {
        allow read, write: if isMember(familyId);
      }

      // Регулярные платежи: шаблон счёта. Сама оплата — обычная транзакция
      // с полем billId, поэтому здесь только описание, без сумм за месяцы.
      match /bills/{billId} {
        allow read, write: if isMember(familyId);
      }

      match /meta/{docId} {
        allow read, write: if isMember(familyId);
      }
    }

    // ---------------------------------------------------------------- цены

    // Общая база цен: сколько стоил товар, в каком магазине и когда.
    // Читают её все авторизованные — в этом весь смысл сравнения цен.
    // Писать можно только свои строки: uid в документе должен совпадать
    // с тем, кто пишет, поэтому чужую цену подменить нельзя.
    match /prices/{priceId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}
